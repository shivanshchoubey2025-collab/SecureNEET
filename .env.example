# =====================================================================
# SecureNEET — Environment Configuration
# Copy this file to '.env' and fill in your production values.
# NEVER commit real production credentials to version control.
# =====================================================================

# Flask Environment
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=replace_with_a_cryptographically_secure_random_64_character_string

# Database Configuration (MySQL is primary for persistent production data)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=secureneet
DB_USER=root
DB_PASSWORD=your_mysql_database_password_here

# SQLite Local Development Path (Used only if DB_TYPE=sqlite or fallback)
SQLITE_PATH=secureneet.db

# Security & Session Settings
SESSION_LIFETIME_SECONDS=7200
EXAM_GRACE_PERIOD_SECONDS=30
MAX_ATTEMPTS_PER_EXAM=1

# Optional CORS / Allowed Origins
ALLOWED_ORIGINS=https://secureneet.org,http://localhost:5000
